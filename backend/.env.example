# =============================================================
# SmartHospitalAI — Backend environment variables template
# =============================================================
# Copy this file to a local-only location and set REAL values.
# NEVER commit real credentials.
# =============================================================

# MySQL database connection
DB_URL=jdbc:mysql://localhost:3306/hospital_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server port (Render/Railway sets this automatically)
PORT=8081

# CORS: set to your Vercel frontend URL in production
# e.g. https://smart-hospital-ai.vercel.app
ALLOWED_ORIGIN=*

# AI Service URL used by the frontend (set in frontend .env, not here)
# AI_SERVICE_URL=https://your-flask-service.onrender.com
